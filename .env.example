# Copier ce fichier en .env et remplir les valeurs
# Ne jamais committer .env sur GitHub

# ─── TMDB ─────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ─── MinIO (Data Lake local) ──────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tmdb-lake

# ─── Airflow → Docker spawn ───────────────────────────────────────────────────
# Chemin HOST du projet, format accepté par le daemon Docker Desktop.
# Sur Windows : "C:/Users/foo/projet" (forward slashes !).
# Sur Linux/Mac : "/home/user/projet".
# Permet au scheduler Airflow de monter le projet dans les containers Spark.
PROJECT_HOST_PATH=/path/to/your/project
DOCKER_NETWORK=finalpipelinev1_default
TMDB_MAX_PAGES=3

# ─── Snowflake (auth par paire de clés RSA) ───────────────────────────────────
# Générer la paire :
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM \
#     -out config/keys/snowflake_rsa_key.p8 -nocrypt
#   openssl rsa -in config/keys/snowflake_rsa_key.p8 -pubout \
#     -out config/keys/snowflake_rsa_key.pub
# Puis dans Snowsight : ALTER USER <USER> SET RSA_PUBLIC_KEY='<contenu .pub sans BEGIN/END>';
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_user
SNOWFLAKE_PRIVATE_KEY_PATH=config/keys/snowflake_rsa_key.p8
SNOWFLAKE_DATABASE=TMDB_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=PIPELINE_ROLE
