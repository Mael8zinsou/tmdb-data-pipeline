    {
      "type": "timeseries",
      "title": "Durée par task — tmdb_pipeline (p99, secondes)",
      "id": 5,
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "airflow_task_duration_seconds{dag_id=\"tmdb_pipeline\", quantile=\"0.99\"}",
